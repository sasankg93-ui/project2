APP_API_KEY=change-me

# AWS (omit the keys if running on an IAM role)
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
S3_BUCKET=my-media-bucket
S3_UPLOAD_PREFIX=uploads/
S3_OUTPUT_PREFIX=processed/
S3_PRESIGN_EXPIRES=900
# Only for LocalStack/MinIO, e.g. http://localhost:4566
S3_ENDPOINT_URL=
# CloudFront domain serving the bucket's processed/ prefix; empty = presigned S3 URLs
CDN_DOMAIN=

# Local (non-Docker) run. Docker Compose overrides these.
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
REDIS_URL=redis://localhost:6379/0
RABBITMQ_USER=media
RABBITMQ_PASSWORD=change-me-too

MAX_UPLOAD_BYTES=2147483648
WATERMARK_TEXT=
